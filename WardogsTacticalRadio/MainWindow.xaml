<Window x:Class="WardogsTacticalRadio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WARDOGS Tactical Communications // WR-25"
        Width="1500" Height="960" MinWidth="1180" MinHeight="780"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0B0C0A" BorderBrush="#43463D" BorderThickness="0,0,0,1">
            <Grid Margin="16,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WARDOGS" FontFamily="Arial Black" FontSize="31" Foreground="#C8C0A3"/>
                    <TextBlock Text="TACTICAL COMMUNICATIONS // WR-25 NETWORK RADIO" FontSize="12" Foreground="#8E927F"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="SAME FIGHT // DIFFERENT FREQUENCY" FontSize="13" Foreground="#B7B29D"/>
                    <TextBlock x:Name="VersionText" Text="v0.1.0-alpha2a" HorizontalAlignment="Right" Foreground="#73766A"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left rail -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Margin="0,10,10,0" Background="#141713" BorderBrush="#46493F" BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="10">
                <Button Style="{StaticResource TacticalButton}" Content="▣  RADIO" Background="#244427"/>
                <Button Style="{StaticResource TacticalButton}" Content="⌂  HOME"/>
                <Button Style="{StaticResource TacticalButton}" Content="●  FRIENDS"/>
                <Button Style="{StaticResource TacticalButton}" Content="▤  KNOWN SERVERS"/>
                <Button Style="{StaticResource TacticalButton}" Content="◷  RECENT"/>
                <Button Style="{StaticResource TacticalButton}" Content="⚙  SETTINGS"/>
                <Separator Margin="6,16" Background="#4C4E45"/>
                <TextBlock Text="STATUS" Foreground="#888B7B" FontSize="11"/>
                <TextBlock x:Name="LeftStatusText" Text="● OFFLINE" Foreground="{StaticResource Amber}" FontSize="13" Margin="0,2,0,0"/>
                <Button x:Name="DisconnectButton" Style="{StaticResource TacticalButton}" Content="DISCONNECT" FontSize="11" Background="#5A2A24" IsEnabled="False" Margin="0,6,3,14" Click="DisconnectButton_Click"/>
                <TextBlock Text="USERNAME" Foreground="#777A70" FontSize="10"/>
                <TextBlock x:Name="UserNameText" Text="Operator" FontSize="14" Margin="0,1,0,10"/>
                <TextBlock Text="CALLSIGN" Foreground="#777A70" FontSize="10"/>
                <TextBlock x:Name="CallsignText" Text="ALPHA-1" FontSize="14" Margin="0,1,0,10"/>
                <TextBlock Text="ROLE" Foreground="#777A70" FontSize="10"/>
                <TextBlock x:Name="RoleText" Text="Squad Leader" FontSize="14" Margin="0,1,0,10"/>
                <TextBlock Text="HOST ELIGIBLE" Foreground="#777A70" FontSize="10"/>
                <TextBlock x:Name="HostEligibleText" Text="● YES" Foreground="{StaticResource Green}" FontSize="13" Margin="0,1,0,10"/>
                <TextBlock Text="LOCAL ADDRESS" Foreground="#777A70" FontSize="10"/>
                <TextBlock x:Name="LocalAddressText" Text="Detecting..." FontSize="12" TextWrapping="Wrap"/>
                <TextBlock x:Name="AudioStatusText" Text="AUDIO: INITIALIZING" Foreground="#8E927F" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Main radio -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,10,10,0" Background="#2C2E26" BorderBrush="#706B58" BorderThickness="3" CornerRadius="8" Padding="17">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="WARDOGS // WR-25" FontFamily="Arial Black" FontSize="24" Foreground="#BDB59A"/>

                <Grid Grid.Row="1" Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button x:Name="CmdButton" Style="{StaticResource TacticalButton}" Content="CMD" Click="CmdButton_Click" FontSize="18" Height="52" Background="#27522E"/>
                        <Button x:Name="SqdButton" Style="{StaticResource TacticalButton}" Content="SQD" Click="SqdButton_Click" FontSize="18" Height="52" Background="#6A4D1E"/>
                        <Button Style="{StaticResource TacticalButton}" Content="AUX" FontSize="16" Height="46" IsEnabled="False"/>
                        <Button Style="{StaticResource TacticalButton}" Content="VEH" FontSize="16" Height="46" IsEnabled="False"/>
                        <Button Style="{StaticResource TacticalButton}" Content="SUP" FontSize="16" Height="46" IsEnabled="False"/>
                        <Button Style="{StaticResource TacticalButton}" Content="DIR" FontSize="16" Height="46" IsEnabled="False"/>
                    </StackPanel>

                    <Border Grid.Column="1" Margin="10,0" Background="{StaticResource Lcd}" BorderBrush="#0A0F05" BorderThickness="8" CornerRadius="5" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="35"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="NetTitleText" Text="NET: STANDBY" Foreground="{StaticResource LcdDark}" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="▂▄▆█" HorizontalAlignment="Right" Foreground="{StaticResource LcdDark}" FontSize="18"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.48*"/><ColumnDefinition Width="0.52*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CMD   CH 01   [MON]" Foreground="{StaticResource LcdDark}" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="SQD   CH 02   [MON]" Foreground="{StaticResource LcdDark}" FontSize="17" FontWeight="Bold" Margin="0,7,0,0"/>
                                    <TextBlock Text="AUX   --      [OFF]" Foreground="#455323" FontSize="16" Margin="0,7,0,0"/>
                                    <TextBlock Text="VEH   --      [OFF]" Foreground="#455323" FontSize="16" Margin="0,7,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="#516427" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="RxTxLargeText" Text="STBY" Foreground="{StaticResource LcdDark}" FontSize="48" FontWeight="Bold"/>
                                        <TextBlock x:Name="ActiveCallsignText" Text="NO ACTIVE TRANSMISSION" Foreground="{StaticResource LcdDark}" FontSize="19" FontWeight="Bold"/>
                                        <TextBlock x:Name="SessionIdText" Text="NET ID: --------" Foreground="#334316" FontSize="13" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="2">
                                <TextBlock x:Name="LcdStatusText" Text="SIG: ----   NET: 0   HOST: NONE" Foreground="{StaticResource LcdDark}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Ellipse x:Name="RxLamp" Width="17" Height="17" Fill="#32502F"/><TextBlock Text=" RX" FontSize="17"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Ellipse x:Name="TxLamp" Width="17" Height="17" Fill="#483632"/><TextBlock Text=" TX" FontSize="17"/></StackPanel>
                        <Button x:Name="PttButton" Background="#171A15" BorderBrush="#5E6255" BorderThickness="2" Width="72" Height="180" Padding="0" PreviewMouseLeftButtonDown="PttButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PttButton_PreviewMouseLeftButtonUp">
                            <Grid><Rectangle Width="38" Height="115" RadiusX="8" RadiusY="8" Fill="#353A32" Stroke="#75796B" VerticalAlignment="Top" Margin="0,13,0,0"/><TextBlock Text="PTT" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="16"/></Grid>
                        </Button>
                        <TextBlock x:Name="TxChannelText" Text="TX NET: SQD" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center"><Ellipse Width="90" Height="90" Fill="#171915" Stroke="#777364" StrokeThickness="3"/><TextBlock Text="VOL" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource TacticalButton}" Content="MON" Width="76"/><Button Style="{StaticResource TacticalButton}" Content="SCAN" Width="76" IsEnabled="False"/><Button Style="{StaticResource TacticalButton}" Content="PRI" Width="76" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center"><Ellipse Width="90" Height="90" Fill="#171915" Stroke="#777364" StrokeThickness="3"/><TextBlock Text="CHANNEL" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Social -->
        <Border Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Background="#141713" BorderBrush="#46493F" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <GroupBox Header="FRIENDS" Foreground="#C7C8BA" BorderBrush="#4B4E45" Margin="0,0,0,7">
                    <ListBox x:Name="FriendsList" Background="Transparent" BorderThickness="0" Foreground="#D6D7CB" FontFamily="Consolas" Margin="5"/>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="KNOWN SERVERS" Foreground="#C7C8BA" BorderBrush="#4B4E45" Margin="0,7">
                    <ListBox x:Name="ServersList" Background="Transparent" BorderThickness="0" Foreground="#D6D7CB" FontFamily="Consolas" Margin="5"/>
                </GroupBox>
                <GroupBox Grid.Row="2" Header="RECENT SESSIONS" Foreground="#C7C8BA" BorderBrush="#4B4E45" Margin="0,7,0,0">
                    <ListBox x:Name="RecentList" Background="Transparent" BorderThickness="0" Foreground="#D6D7CB" FontFamily="Consolas" Margin="5"/>
                </GroupBox>
            </Grid>
        </Border>

        <!-- Host/join -->
        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Background="#151813" BorderBrush="#4B4E44" BorderThickness="1" CornerRadius="4" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="HOST RADIO NET" FontSize="14" FontWeight="Bold"/>
                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="SESSION" VerticalAlignment="Center"/><TextBox x:Name="HostSessionNameBox" Grid.Column="1" Style="{StaticResource TacticalInput}" Text="Kirk's Radio Net"/></Grid>
                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="PASSWORD" VerticalAlignment="Center"/><PasswordBox x:Name="HostPasswordBox" Grid.Column="1" Style="{StaticResource TacticalPassword}" ToolTip="Required. Anyone joining this net must enter this password."/></Grid>
                    <Button x:Name="HostButton" Style="{StaticResource TacticalButton}" Content="HOST RADIO NET" Background="#23552A" Margin="0,8,0,0" Click="HostButton_Click"/>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="PrepareInternetHostingButton" Style="{StaticResource TacticalButton}" Content="PREPARE INTERNET HOSTING" FontSize="10" Click="PrepareInternetHostingButton_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource TacticalButton}" Content="OPEN ROUTER PAGE" FontSize="10" Click="OpenRouterButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="ConnectivityStatusText" Text="INTERNET HOSTING: NOT CHECKED" Foreground="#8E927F" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#44473D" Width="1"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="JOIN RADIO NET" FontSize="14" FontWeight="Bold"/>
                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ADDRESS" VerticalAlignment="Center"/><TextBox x:Name="JoinAddressBox" Grid.Column="1" Style="{StaticResource TacticalInput}" Text="127.0.0.1"/></Grid>
                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="PASSWORD" VerticalAlignment="Center"/><PasswordBox x:Name="JoinPasswordBox" Grid.Column="1" Style="{StaticResource TacticalPassword}"/></Grid>
                    <Button x:Name="JoinButton" Style="{StaticResource TacticalButton}" Content="JOIN RADIO NET" Margin="0,8,0,0" Click="JoinButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
